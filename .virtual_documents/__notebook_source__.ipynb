import os
import subprocess
import threading
import time
import sys

# 1. Download VS Code CLI (Linux x64)
CLI_URL = "https://code.visualstudio.com/sha/download?build=stable&os=cli-alpine-x64"
CLI_TAR = "vscode_cli.tar.gz"

if not os.path.exists("code"):
    print("正在下载 VS Code CLI...")
    # Use the plain URL (no brackets)
    ret = subprocess.run(
        f"curl -Lk '{CLI_URL}' --output {CLI_TAR}",
        shell=True,
        capture_output=True,
        text=True
    )
    if ret.returncode != 0:
        print("下载失败:", ret.stderr)
        sys.exit(1)
    
    # Extract
    subprocess.run(f"tar -xf {CLI_TAR}", shell=True, check=True)
    os.remove(CLI_TAR)
    # Make executable
    os.chmod("code", 0o755)
    print("下载完成。")

# 2. Heartbeat thread (keeps Kaggle kernel alive)
def heartbeat():
    while True:
        sys.stderr.write(f"\n[Heartbeat] 节点活跃中 - {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        sys.stderr.flush()
        _ = [i**2 for i in range(100)]
        time.sleep(600)

threading.Thread(target=heartbeat, daemon=True).start()
print("后台保活心跳已启动。")

# 3. Start VS Code Tunnel
print("正在启动 VS Code Tunnel...")
print("请访问 https://github.com/login/device 并输入 8 位验证码。")

# Run tunnel (use Popen to stream output live)
os.system("./code tunnel --accept-server-license-terms --name kaggle-gpu-node")
